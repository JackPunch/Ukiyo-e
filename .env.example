# --- API (apps/api) ---
PORT=3000
HOST=0.0.0.0
# SQLite file. Relative paths resolve against apps/api/ (not the cwd); use
# `:memory:` for a throwaway in-memory database. Loaded via `npm run dev:api`.
DATABASE_URL=./data/ukiyo-e.sqlite

# Session JWT signing key (HS256). MUST be at least 32 characters — the API
# refuses to start otherwise, so that it can never run on a guessable key.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-please-replace-0123456789abcdef
# Token lifetime, also used as the session cookie's Max-Age. One of
# <n>s / <n>m / <n>h / <n>d (e.g. 45s, 30m, 12h, 7d).
JWT_TTL=7d

# Bootstrap admin, applied on every startup and idempotent. ADMIN_PASSWORD is
# only used when the account does not exist yet: for an existing account the
# role is promoted and the password is left untouched.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password

# Forces the session cookie's Secure flag. Defaults to true only when
# NODE_ENV=production; set to false for plain-HTTP local debugging.
# COOKIE_SECURE=false

# --- Web (apps/web) ---
# Leave empty during local dev to use the Vite proxy (/api -> http://localhost:3000).
# VITE_API_BASE=http://localhost:3000/api
